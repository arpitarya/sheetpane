{
  "name": "sheetpane-monorepo",
  "private": true,
  "description": "sheetpane — an .xlsx/.csv viewer and editor for single-page apps, the import and export libraries it uses, and its plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arpitarya/sheetpane"
  },
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "vitest run --coverage",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.json --noEmit"
  },
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "@sheetpane/export": "workspace:*",
    "@sheetpane/import": "workspace:*",
    "@sheetpane/testing": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "fast-check": "4.10.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
