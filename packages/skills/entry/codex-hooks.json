{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no sheetpane-skills check-rules --hook codex",
            "timeout": 60,
            "statusMessage": "Checking the sheetpane rules file"
          }
        ]
      }
    ]
  }
}
