{
  "name": "@sheetpane/export",
  "version": "0.1.0",
  "description": "Turn a plain JavaScript object into an .xlsx or .csv file. No runtime dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpitarya/sheetpane.git",
    "directory": "packages/export"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "papaparse": "5.7.0"
  },
  "dependencies": {
    "@sheetpane/skills": "workspace:*"
  }
}
