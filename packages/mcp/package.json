{
  "name": "@sheetpane/mcp",
  "version": "0.4.1",
  "description": "A Model Context Protocol server for sheetpane: describe the API, inspect a workbook, draft and check a rules file, diff two versions of a workbook, explain an SP code, find a skill — deterministic, read-only, over stdio.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpitarya/sheetpane.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sheetpane-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-data.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sheetpane/compare": "workspace:*",
    "@sheetpane/grid": "workspace:*",
    "@sheetpane/import": "workspace:*",
    "@sheetpane/skills": "workspace:*"
  },
  "devDependencies": {
    "@sheetpane/fixtures": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
