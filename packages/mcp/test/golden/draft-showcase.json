              "ppm",
              "ug/L"
            ]
          },
          "Meaning": {}
        }
      }
    }
  },
  "notes": [
    "“Numbers” column “Value” mixes types — no type drafted",
    "“Tables” column “Meaning” mixes types — no type drafted",
    "“Tables” column C has no title in row 1 — no rule drafted"
