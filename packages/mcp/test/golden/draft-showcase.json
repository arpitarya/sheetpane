            "required": true,
            "type": "integer"
          },
          "Bars": {
            "required": true,
            "type": "integer"
          },
          "Over 50": {
            "required": true,
            "type": "integer"
          }
        }
      },
      "Images": {
        "columns": {
          "A picture anchored to B3:E9": {}
        }
      },
      "Charts": {
        "columns": {
          "Month": {
            "required": true,
            "type": "text"
          },
          "Sales": {
            "required": true,
            "type": "integer"
          },
          "Costs": {
            "required": true,
            "type": "integer"
          }
        }
      },
      "Comments": {
        "columns": {
          "Account": {
            "required": true,
            "type": "text"
          },
          "Price": {
            "required": true,
            "type": "number"
          }
        }
      },
      "Tables": {
        "columns": {
          "Unit": {
            "type": "text",
            "oneOf": [
              "%",
              "Copper",
              "Lead",
              "Moisture",
              "Parameter",
              "Total",
              "Zinc",
