            "required": true,
            "type": "text"
          },
          "Amount": {
            "required": true,
            "type": "integer"
          }
        }
      },
      "Validation": {
        "columns": {
          "Account": {
            "required": true,
            "type": "text"
          },
          "Status": {
            "required": true,
            "type": "text",
            "oneOf": [
              "Active",
              "Bogus",
              "Inactive"
            ]
          },
          "Units": {
            "required": true,
            "type": "integer"
          }
        }
      },
      "CondFmt": {
        "columns": {
