{
  "name": "@sheetpane/grid",
  "version": "0.4.1",
  "description": "View and edit .xlsx and .csv files inside any web page: the <sheetpane-excel> and <sheetpane-errors> web components, always in sync through one in-memory workbook.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpitarya/sheetpane.git",
    "directory": "packages/grid"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/index.js",
    "./src/index.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./check": {
      "source": "./src/check.ts",
      "types": "./dist/check.d.ts",
      "import": "./dist/check.js"
    },
    "./static": {
      "source": "./src/static.ts",
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js"
    },
    "./style.css": "./dist/style.css",
    "./rules.schema.json": "./dist/rules.schema.json",
    "./llms.txt": "./dist/llms.txt",
    "./jsx": {
      "source": "./src/frameworks/jsx.d.ts",
      "types": "./dist/frameworks/jsx.d.ts",
      "import": "./dist/frameworks/jsx.js"
    },
    "./vue": {
      "source": "./src/frameworks/vue.d.ts",
      "types": "./dist/frameworks/vue.d.ts",
      "import": "./dist/frameworks/vue.js"
    },
    "./svelte": {
      "source": "./src/frameworks/svelte.d.ts",
      "types": "./dist/frameworks/svelte.d.ts",
      "import": "./dist/frameworks/svelte.js"
    },
    "./solid": {
      "source": "./src/frameworks/solid.d.ts",
      "types": "./dist/frameworks/solid.d.ts",
      "import": "./dist/frameworks/solid.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./vscode.html-custom-data.json": "./dist/vscode.html-custom-data.json",
    "./vscode.css-custom-data.json": "./dist/vscode.css-custom-data.json",
    "./web-types.json": "./dist/web-types.json"
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "customElements": "custom-elements.json",
  "web-types": "./dist/web-types.json",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-grid-css.mjs && node ../../scripts/build-manifest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sheetpane/export": "workspace:*",
    "@sheetpane/import": "workspace:*",
    "@sheetpane/skills": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./check": {
        "types": "./dist/check.d.ts",
        "import": "./dist/check.js"
      },
      "./static": {
        "types": "./dist/static.d.ts",
        "import": "./dist/static.js"
      },
      "./style.css": "./dist/style.css",
      "./rules.schema.json": "./dist/rules.schema.json",
      "./llms.txt": "./dist/llms.txt",
      "./jsx": {
        "types": "./dist/frameworks/jsx.d.ts",
        "import": "./dist/frameworks/jsx.js"
      },
      "./vue": {
        "types": "./dist/frameworks/vue.d.ts",
        "import": "./dist/frameworks/vue.js"
      },
      "./svelte": {
        "types": "./dist/frameworks/svelte.d.ts",
        "import": "./dist/frameworks/svelte.js"
      },
      "./solid": {
        "types": "./dist/frameworks/solid.d.ts",
        "import": "./dist/frameworks/solid.js"
      },
      "./custom-elements.json": "./custom-elements.json",
      "./vscode.html-custom-data.json": "./dist/vscode.html-custom-data.json",
      "./vscode.css-custom-data.json": "./dist/vscode.css-custom-data.json",
      "./web-types.json": "./dist/web-types.json"
    }
  },
  "bin": {
    "sheetpane-skills": "./dist/skills-bin.js"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  }
}
