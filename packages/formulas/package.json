{
  "name": "@sheetpane/formulas",
  "version": "0.5.1",
  "description": "Formula recalculation for sheetpane — edit a cell and every dependent formula updates — as a plugin on the `derive` hook, backed by IronCalc (WASM, lazy-loaded).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpitarya/sheetpane.git",
    "directory": "packages/formulas"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/ui.js",
    "./src/index.ts",
    "./src/ui.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "source": "./src/ui.ts",
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@sheetpane/grid": "workspace:*"
  },
  "dependencies": {
    "@ironcalc/wasm": "0.9.0",
    "@sheetpane/skills": "workspace:*"
  },
  "devDependencies": {
    "@sheetpane/grid": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./ui": {
        "types": "./dist/ui.d.ts",
        "import": "./dist/ui.js"
      }
    }
  }
}
