{
  "name": "create-sheetpane",
  "version": "0.2.0",
  "description": "`npm create sheetpane` — a working sheetpane app in vanilla, React, Next.js, Vue, Angular or Svelte: the sheet and its errors panel, a sample file and rules file, one test, and the agent skills.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpitarya/sheetpane.git",
    "directory": "packages/create-sheetpane"
  },
