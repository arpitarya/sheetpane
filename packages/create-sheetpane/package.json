  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "create-sheetpane": "./bin/create-sheetpane.mjs"
  },
  "exports": {
    "./bin": {
      "types": "./bin/create-sheetpane.d.mts",
      "default": "./bin/create-sheetpane.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "templates"
  ],
  "scripts": {
    "build": "node -e \"\"",
    "typecheck": "node -e \"\""
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  }
