{
  "name": "@sheetpane/numfmt",
  "version": "0.0.0",
  "description": "Excel number formats for sheetpane — currency, dates, fractions, elapsed time, conditional sections, locales — as a plugin on the `format` hook.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@sheetpane/grid": "0.0.0"
  },
  "dependencies": {
    "numfmt": "4.0.1"
  }
}
