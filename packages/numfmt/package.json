{
  "name": "@sheetpane/numfmt",
  "version": "0.4.1",
  "description": "Excel number formats for sheetpane — currency, dates, fractions, elapsed time, conditional sections, locales — as a plugin on the `format` hook.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpitarya/sheetpane.git",
    "directory": "packages/numfmt"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/ui.js",
    "./src/index.ts",
    "./src/ui.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "source": "./src/ui.ts",
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@sheetpane/grid": "workspace:*"
  },
  "dependencies": {
    "@sheetpane/skills": "workspace:*",
    "numfmt": "4.0.1"
  },
  "devDependencies": {
    "@sheetpane/grid": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./ui": {
        "types": "./dist/ui.d.ts",
        "import": "./dist/ui.js"
      }
    }
  }
}
