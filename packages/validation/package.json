{
  "name": "@sheetpane/validation",
  "version": "0.4.2",
  "description": "Data validation for sheetpane — the workbook's own `<dataValidations>` rules checked on load and on every edit, landing in <sheetpane-errors> — as a plugin on the `validate` hook.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpitarya/sheetpane.git",
    "directory": "packages/validation"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/ui.js",
    "./src/index.ts",
    "./src/ui.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./check": {
      "source": "./src/check.ts",
      "types": "./dist/check.d.ts",
      "import": "./dist/check.js"
    },
    "./ui": {
      "source": "./src/ui.ts",
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@sheetpane/grid": "workspace:*"
  },
  "dependencies": {
    "@sheetpane/export": "workspace:*",
    "@sheetpane/skills": "workspace:*"
  },
  "devDependencies": {
    "@sheetpane/formulas": "workspace:*",
    "@sheetpane/grid": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./check": {
        "types": "./dist/check.d.ts",
        "import": "./dist/check.js"
      },
      "./ui": {
        "types": "./dist/ui.d.ts",
        "import": "./dist/ui.js"
      }
    }
  }
}
