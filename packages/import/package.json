{
  "name": "@sheetpane/import",
  "version": "0.0.0",
  "description": "Read an .xlsx or .csv file into the plain JavaScript Workbook object @sheetpane/export writes — raw values, display text, merges, and everything the plugins read. No runtime dependency but @sheetpane/export.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpitarya/sheetpane.git",
    "directory": "packages/import"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sheetpane/export": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "exceljs": "4.4.0",
    "fflate": "0.8.3"
  }
}
